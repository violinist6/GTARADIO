<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GTARadio</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.0" />
    <ProjectReference Include="../CodeWalker.Core/CodeWalker.Core.csproj" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="www/**" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
